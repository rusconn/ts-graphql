# pgschema
PGDATABASE=test

# app
DATABASE_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${DB_PORT}/test?sslmode=disable
NODE_ENV=test
PASSWORD_HASH_MEMORY_COST=4096
PASSWORD_HASH_TIME_COST=1
PASSWORD_HASH_PARALLELISM=1

# signup
SIGNUP_EMAIL_VERIFICATION_TTL_SECONDS=3600
SIGNUP_REQUEST_RATE_LIMIT_CAPACITY=10000
SIGNUP_REQUEST_RATE_LIMIT_REFILL_PER_SECOND=200
SIGNUP_REQUEST_RATE_LIMIT_BUCKET_TTL_SECONDS=60
